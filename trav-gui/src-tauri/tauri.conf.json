{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Trav",
  "version": "0.3.0",
  "identifier": "xyz.kkrwhofrags.trav",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trav",
        "width": 1320,
        "height": 840,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0c0d10",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "A fast, quiet BitTorrent client",
    "longDescription": "Trav is a BitTorrent client for macOS built on a headless async Rust engine: magnet links, DHT, PEX, UPnP, sequential download, per-file selection, queueing and rate limits.",
    "copyright": "© 2026 Cyrus Kakkar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "mimeType": "application/x-bittorrent",
        "name": "BitTorrent Document",
        "description": "BitTorrent metadata file",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDNTg4MUZGQTYwODc2MUEKUldRYWRnaW0vNEZZSEl3eGZWNFc1ZUhFUnM2R1JQUHQ3KzB4Qy90QnRMQjZLVGVCQ1YybnBQK2wK",
      "endpoints": [
        "https://github.com/ckakkar/trav/releases/latest/download/latest.json"
      ]
    }
  }
}
